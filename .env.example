# Run bash scripts/init.sh to generate .env with unique secrets.
ACME_EMAIL=you@example.com
KOMARI_DOMAIN=komari.example.com
UMAMI_DOMAIN=umami.example.com
# auto selects free ports once and saves them; random always chooses high ports.
PORT_MODE=auto
HTTP_PORT=auto
HTTPS_PORT=auto
CADDY_CONFIG=Caddyfile
COMPOSE_FILE=compose.yaml
KOMARI_IMAGE=ghcr.io/komari-monitor/komari:1.5.1
UMAMI_IMAGE=ghcr.io/umami-software/umami:3.4.0
CADDY_IMAGE=caddy:2.10.2-alpine
POSTGRES_IMAGE=postgres:15.14-alpine
# Hex only: avoids PostgreSQL connection URL escaping issues.
POSTGRES_PASSWORD=
APP_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=
